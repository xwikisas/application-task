    <property>
      <code>require(['jquery', 'xwiki-selectize'], function($) {
  'use strict';
  var webHome = 'WebHome';

  /**
   * The values are stored as references to the home page of the selected spaces (e.g. "Sandbox.WebHome"), so that
   * they remain compatible with the page property type.
   */
  var getSpaceOption = function(spaceReference, documentReference) {
    var homeReference = new XWiki.EntityReference(webHome, XWiki.EntityType.DOCUMENT, spaceReference);
    var value = XWiki.Model.serialize(homeReference.relativeTo(documentReference.getRoot()));
    var spaces = spaceReference.getReversedReferenceChain().filter(function(component) {
      return component.type === XWiki.EntityType.SPACE;
    }).map(function(component) {
      return component.name;
    });
    return {
      value: value,
      searchValue: XWiki.Model.serialize(spaceReference.relativeTo(documentReference.getRoot())),
      label: spaces.pop(),
      hint: spaces.join(' / '),
      url: new XWiki.Document(homeReference).getURL()
    };
  };

  var loadSpaces = function(text, documentReference) {
    var wiki = documentReference.extractReferenceValue(XWiki.EntityType.WIKI);
    return $.getJSON(XWiki.Document.getRestSearchURL('', [], wiki), $.param({
      q: text,
      scope: 'spaces',
      number: 10
    })).then(function(response) {
      return (response.searchResults || []).filter(function(result) {
        return result.type === 'space';
      }).map(function(result) {
        return getSpaceOption(XWiki.Model.resolve(result.id, XWiki.EntityType.SPACE), documentReference);
      });
    });
  };

  $.fn.suggestSpaces = function() {
    return this.each(function() {
      var documentReference = XWiki.currentDocument.documentReference;
      $(this).xwikiSelectize({
        create: false,
        searchField: ['searchValue', 'label', 'hint'],
        load: function(text, callback) {
          loadSpaces(text, documentReference).then(callback, function() {
            callback([]);
          });
        },
        loadSelected: function(value, callback) {
          var homeReference = XWiki.Model.resolve(value, XWiki.EntityType.DOCUMENT, documentReference);
          callback([getSpaceOption(homeReference.parent, documentReference)]);
        }
      });
    });
  };

  var init = function(event, data) {
    var container = $((data &amp;&amp; data.elements) || document);
    container.find('.suggest-spaces').suggestSpaces();
  };
  $(document).on('xwiki:dom:updated', init);
  $(init);
});</code>
