    &lt;template id="incompleteTaskOwnerTemplate"&gt;
      &lt;a class="incompleteTaskOwnerLink" href="#"&gt;&lt;/a&gt;
      &lt;button class="incompleteTaskOwnerFix btn btn-secondary" type="button"&gt;&lt;/button&gt;
    &lt;/template&gt;
  &lt;/div&gt;
