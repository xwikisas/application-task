## Displays a picker for task pages.
##
## Supported parameters (any other parameter is added as an attribute of the select element):
## * value: the current value. When the picker accepts multiple values, it can be a collection or a comma separated
##   list of values.
## * multiple: when set (and different than 'false'), the picker accepts multiple values
## * valueType: 'reference' (default) to use the task page references as values or 'number' to use the task numbers
#macro (_taskPicker $parameters)
  #set ($discard = $xwiki.linkx.use($services.webjars.url('selectize.js', 'css/selectize.bootstrap3.css'),
    {'type': 'text/css', 'rel': 'stylesheet'}))
  #set ($discard = $xwiki.ssfx.use('uicomponents/suggest/xwiki.selectize.css', true))
  #set ($discard = $xwiki.jsx.use('TaskManager.TaskPagesSearch'))
  #set ($taskPickerAttributes = {})
  #set ($discard = $taskPickerAttributes.putAll($parameters))
  #set ($taskPickerValue = $taskPickerAttributes.remove('value'))
  #set ($taskPickerValueType = "$!taskPickerAttributes.remove('valueType')")
  #if ($taskPickerValueType == '')
    #set ($taskPickerValueType = 'reference')
  #end
  #set ($taskPickerMultiple = "$!taskPickerAttributes.multiple" != '' && "$!taskPickerAttributes.multiple" != 'false')
  #if ($taskPickerMultiple)
    #set ($taskPickerAttributes.multiple = 'multiple')
    #set ($taskPickerNoValueKey = 'taskmanager.picker.taskpage.multiple.noValue')
  #else
    #set ($discard = $taskPickerAttributes.remove('multiple'))
    #set ($taskPickerNoValueKey = 'taskmanager.picker.taskpage.noValue')
  #end
  ## Collect the selected values so that the picker can display them initially.
  #set ($taskPickerValues = [])
  #if ($taskPickerValue.iterator())
    #set ($discard = $taskPickerValues.addAll($taskPickerValue))
  #elseif ("$!taskPickerValue" != '')
    #if ($taskPickerMultiple)
      #foreach ($taskPickerItem in $stringtool.split("$taskPickerValue", ','))
        #set ($discard = $taskPickerValues.add($taskPickerItem.trim()))
      #end
    #else
      #set ($discard = $taskPickerValues.add("$taskPickerValue"))
    #end
  #end
  <select class="suggest-task-pages" data-value-type="$escapetool.xml($taskPickerValueType)"
    #foreach ($attribute in $taskPickerAttributes.entrySet())
      $escapetool.xml($attribute.key)="$!escapetool.xml($attribute.value)"
    #end
  >
    <option value="">$escapetool.xml($services.localization.render($taskPickerNoValueKey))</option>
    #foreach ($selectedValue in $taskPickerValues)
      #if ("$!selectedValue.toString().trim()" != '')
        <option value="$escapetool.xml($selectedValue)" selected="selected">$escapetool.xml($selectedValue)</option>
      #end
    #end
  </select>
#end
