## Single definition of which pages are retrieved as tasks by the macros and pages that list tasks (task report, gantt,
## kanban board, task manager home page, task panel). Load it with #template('taskQuery_macros.vm') instead of writing
## a dedicated query. It is a template rather than a wiki page so that it can be loaded by the users that don't have
## view right on the TaskManager space.
##
## Inline tasks (created with the task macro, having the 'owner' property set) are hidden pages, so the 'hidden' query
## filter must NOT be used when retrieving tasks. Note that the 'liveTable' Live Data source applies it by default, so
## the $taskQueryFilters have to be passed explicitly to it through the 'queryFilters' source parameter.
##
## This template doesn't contain empty lines, so that it doesn't output anything when loaded.
##
## Constraint that every task query must contain. It excludes the task templates.
#set ($taskQueryBaseConstraint = "doc.space <> 'TaskManager.TaskManagerTemplates'")
## Query filters that every task query must use.
#set ($taskQueryFilters = ['currentlanguage', 'unique'])
##
## Creates the XWQL query retrieving the task pages.
##
## @param $constraints XWQL fragment appended after the base constraint, so it must start with 'and' or 'order by'; the
##   task object is aliased as 'task'
## @param $return the name of the variable that will hold the query
#macro (createTaskQuery $constraints $return)
  #set ($taskQueryStatement = "from doc.object(TaskManager.TaskManagerClass) as task where $taskQueryBaseConstraint")
  #if ("$!constraints" != '')
    #set ($taskQueryStatement = "$taskQueryStatement $constraints")
  #end
  #set ($taskQuery = $services.query.xwql($taskQueryStatement))
  #foreach ($taskQueryFilter in $taskQueryFilters)
    #set ($taskQuery = $taskQuery.addFilter($taskQueryFilter))
  #end
  #setVariable("$return" $taskQuery)
#end
##
## HQL fragments joining the 'owner' property of the task object, aliased as 'obj' by the live table results. Append
## them to the query only when the task type constraint is not empty, with 'taskTypeOwner.value' as owner value.
#set ($taskOwnerHqlFrom = ', StringProperty as taskTypeOwner')
#set ($taskOwnerHqlWhere = "and taskTypeOwner.id.id = obj.id and taskTypeOwner.id.name = 'owner'")
##
## Creates the constraint restricting the retrieved tasks to a type: standalone tasks, inline tasks or both.
##
## @param $taskType the type of the tasks to retrieve: 'all', 'standalone' or 'inline', case-insensitive; when empty,
##   the type configured in the administration is used
## @param $ownerValue the query expression holding the value of the task 'owner' property, e.g. 'task.owner' in XWQL
## @param $return the name of the variable that will hold the constraint, empty or starting with 'and'
#macro (getTaskTypeConstraint $taskType $ownerValue $return)
  #set ($taskTypeValue = "$!taskType")
  #if ($taskTypeValue == '')
    #set ($taskTypeValue = "$services.task.configuration.displayedTaskType")
  #end
  ## Oracle stores empty strings as null, hence the null check and the "like '_%'" check of non-empty owners.
  #if ($taskTypeValue.equalsIgnoreCase('standalone'))
    #set ($taskTypeConstraint = "and ($ownerValue is null or $ownerValue = '')")
  #elseif ($taskTypeValue.equalsIgnoreCase('inline'))
    #set ($taskTypeConstraint = "and $ownerValue like '_%'")
  #else
    #set ($taskTypeConstraint = '')
  #end
  #setVariable("$return" $taskTypeConstraint)
#end
