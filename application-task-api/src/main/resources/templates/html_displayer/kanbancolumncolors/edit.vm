## The Kanban board JSX hides this input in the macro editor, along with the picker of the columns parameter, and
## displays instead a list of the selected columns, built from the templates below, where the columns are added,
## removed, reordered and colored. It computes the value of both parameters from that list.
#set ($discard = $xwiki.jsx.use('TaskManager.KanbanBoardMacro'))
#set ($discard = $xwiki.ssx.use('TaskManager.KanbanBoardMacro'))
<input type="text" class="kanban-column-colors"
  #foreach ($parameter in $displayer.parameters.entrySet())
    $escapetool.xml($parameter.key)="$!escapetool.xml($parameter.value)"
  #end
/>
<template class="kanban-columns-editor-template">
  <div class="kanban-columns-editor">
    <ul class="list-group kanban-columns"></ul>
    <p class="text-muted kanban-columns-empty">
      $escapetool.xml($services.localization.render('taskmanager.kanbanboard.columns.empty'))
    </p>
    <div class="dropdown kanban-columns-add">
      <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown"
          aria-haspopup="true" aria-expanded="false">
        $services.icon.renderHTML('add')
        $escapetool.xml($services.localization.render('taskmanager.kanbanboard.columns.add'))
        <span class="caret"></span>
      </button>
      <ul class="dropdown-menu">
        <li class="kanban-columns-search">
          #set ($searchHint = $services.localization.render('taskmanager.kanbanboard.columns.search'))
          <input type="search" class="form-control input-sm" placeholder="$escapetool.xml($searchHint)"
            aria-label="$escapetool.xml($searchHint)"/>
        </li>
        <li class="dropdown-header kanban-columns-no-match">
          $escapetool.xml($services.localization.render('taskmanager.kanbanboard.columns.noMatch'))
        </li>
      </ul>
    </div>
  </div>
</template>
<template class="kanban-column-template">
  <li class="list-group-item kanban-column">
    #set ($reorderHint = $services.localization.render('taskmanager.kanbanboard.columns.reorder'))
    <span class="kanban-column-handle" role="button" tabindex="0" title="$escapetool.xml($reorderHint)"
      aria-label="$escapetool.xml($reorderHint)">$services.icon.renderHTML('menu')</span>
    #set ($colorHint = $services.localization.render('taskmanager.kanbanboard.columnColor'))
    <input type="color" class="kanban-column-color" title="$escapetool.xml($colorHint)"
      aria-label="$escapetool.xml($colorHint)"/>
    <span class="kanban-column-name"></span>
    #set ($removeHint = $services.localization.render('taskmanager.kanbanboard.columns.remove'))
    <button type="button" class="btn btn-default btn-xs kanban-column-remove" title="$escapetool.xml($removeHint)"
      aria-label="$escapetool.xml($removeHint)">$services.icon.renderHTML('cross')</button>
  </li>
</template>
<template class="kanban-column-suggestion-template">
  <li class="kanban-column-suggestion">
    <a href="#"><span class="kanban-column-suggestion-name"></span>$services.icon.renderHTML('add')</a>
  </li>
</template>
