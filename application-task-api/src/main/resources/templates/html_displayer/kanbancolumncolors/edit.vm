## The Kanban board JSX hides this input in the macro editor and displays instead a color picker next to each column
## selected in the columns parameter, from which it computes the value of this input.
#set ($discard = $xwiki.jsx.use('TaskManager.KanbanBoardMacro'))
#set ($discard = $xwiki.ssx.use('TaskManager.KanbanBoardMacro'))
<input type="text" class="kanban-column-colors"
  data-color-picker-title="$escapetool.xml($services.localization.render('taskmanager.kanbanboard.columnColor'))"
  #foreach ($parameter in $displayer.parameters.entrySet())
    $escapetool.xml($parameter.key)="$!escapetool.xml($parameter.value)"
  #end
/>
